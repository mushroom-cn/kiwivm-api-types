{
  "name": "kiwivm-api-types",
  "version": "1.0.0",
  "description": "TypeScript types and axios-based client for BandwagonHost (搬瓦工) KiwiVM REST API",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "bandwagonhost",
    "kiwivm",
    "搬瓦工",
    "vps",
    "api",
    "typescript",
    "types",
    "axios",
    "client"
  ],
  "author": "mushroom-cn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mushroom-cn/kiwivm-api-types.git"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "pino": "^9.0.0",
    "ssh2": "^1.16.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/instrumentation-pino": "^0.46.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-logs": "^0.57.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0"
  },
  "packageManager": "pnpm@11.2.2"
}
